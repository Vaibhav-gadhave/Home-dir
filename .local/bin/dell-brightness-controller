#!/usr/bin/env python3
import sys
import os
import subprocess
import tkinter as tk
from tkinter import messagebox

class BrightnessController:
    def __init__(self, root):
        self.root = root
        self.root.title("Monitor Brightness")
        self.root.geometry("400x180")
        self.root.resizable(False, False)
        
        # UI Elements
        self.label = tk.Label(root, text="Dell U2415 Brightness", font=("Helvetica", 14, "bold"))
        self.label.pack(pady=10)
        
        self.slider = tk.Scale(root, from_=0, to=100, orient=tk.HORIZONTAL, length=300, command=self.on_slider_move)
        self.slider.pack(pady=5)
        
        self.status_label = tk.Label(root, text="Reading current brightness...", font=("Helvetica", 10, "italic"))
        self.status_label.pack(pady=5)
        
        # Key bindings
        # Binding comma (which is <) and period (which is >) without Shift to make it easier,
        # plus the actual '<' and '>' keys just in case.
        self.root.bind("<period>", lambda e: self.change_brightness(10))
        self.root.bind("<greater>", lambda e: self.change_brightness(10))
        self.root.bind("<comma>", lambda e: self.change_brightness(-10))
        self.root.bind("<less>", lambda e: self.change_brightness(-10))
        
        # Also bind Right/Up and Left/Down arrows for convenience
        self.root.bind("<Right>", lambda e: self.change_brightness(5))
        self.root.bind("<Up>", lambda e: self.change_brightness(5))
        self.root.bind("<Left>", lambda e: self.change_brightness(-5))
        self.root.bind("<Down>", lambda e: self.change_brightness(-5))

        # Setup initial brightness
        self.root.after(100, self.get_initial_brightness)

    def get_initial_brightness(self):
        try:
            # Run ddcutil to get current value
            result = subprocess.run(["ddcutil", "getvcp", "10"], capture_output=True, text=True, check=True)
            # Parse output like: VCP code 10 (Brightness): current value = 60, max value = 100
            for line in result.stdout.splitlines():
                if "current value" in line:
                    parts = line.split("current value =")
                    if len(parts) > 1:
                        val = int(parts[1].split(",")[0].strip())
                        self.slider.set(val)
                        self.status_label.config(text=f"Current: {val}% | Use > or < keys to adjust", font=("Helvetica", 10, "normal"))
                        return
            self.slider.set(50)
            self.status_label.config(text="Could not read hardware value. Defaulted to 50%.")
        except Exception:
            self.slider.set(50)
            self.status_label.config(text="ddcutil failed. Make sure you have permission (sudo usermod -aG i2c $USER).")

    def on_slider_move(self, value):
        val = int(value)
        self.status_label.config(text=f"Current: {val}% | Use > or < keys to adjust")
        # Run ddcutil setting in background to prevent UI lag
        subprocess.Popen(["ddcutil", "setvcp", "10", str(val)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def change_brightness(self, delta):
        current_val = self.slider.get()
        new_val = max(0, min(100, current_val + delta))
        self.slider.set(new_val)

if __name__ == "__main__":
    # Check if ddcutil is installed
    if subprocess.run(["which", "ddcutil"], capture_output=True).returncode != 0:
        root = tk.Tk()
        root.withdraw()
        messagebox.showerror("Error", "ddcutil is not installed. Please run: sudo apt install ddcutil")
        sys.exit(1)
        
    root = tk.Tk()
    app = BrightnessController(root)
    root.mainloop()
